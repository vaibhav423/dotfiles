#!/bin/bash
# bt-only-audio - Bluetooth-speaker-only mode for PipeWire/WirePlumber (Arch + Hyprland)
# Usage:
#   bt-only-audio enable   # mute internal + HDMI outputs, Bluetooth only
#   bt-only-audio disable  # restore internal + HDMI outputs
#   bt-only-audio status   # show mode + sinks
#
# What "enable" does:
#  1. Mutes all alsa_output.pci-* sinks immediately (pactl + ALSA Speaker control)
#  2. Sets default sink to Bluetooth if connected, moves active streams
#  3. For persistence across boots: run `systemctl --user enable --now bt-only-audio.service`
#     (or add 'bt-only-audio enable' to Hyprland autostart)
# What "disable" does: unmutes all wired sinks, restores volumes, moves streams to internal

set -euo pipefail

CONF_DIR="$HOME/.config/wireplumber/wireplumber.conf.d"
CONF_FILE="$CONF_DIR/51-bluetooth-only.conf"

# Detect wired ALSA output sinks dynamically (PCI = internal/HDMI, USB = external wired)
get_wired_sinks() {
    pactl list short sinks 2>/dev/null | awk '$2 ~ /^alsa_output\.(pci-|usb-)/ {print $2}'
}

# Detect Bluetooth sinks
get_bt_sinks() {
    pactl list short sinks 2>/dev/null | awk '$2 ~ /^bluez_output/ {print $2}'
}

# Get the ALSA card number for the internal audio (Generic/AMD/PCH)
get_internal_alsa_card() {
    for d in /proc/asound/card[0-9]*; do
        n=$(basename "$d" | tr -d 'card')
        id=$(cat "$d/id" 2>/dev/null || echo "")
        if [[ "$id" == "Generic" ]] || [[ "$id" == *"HD"* ]] || [[ "$id" == *"PCH"* ]]; then
            echo "$n"
            return
        fi
    done
    # fallback: card 1 is usually the internal on AMD laptops
    echo "1"
}

INTERNAL_CARD=$(get_internal_alsa_card)

# Find the best internal sink (analog-stereo > headphones > first PCI sink on internal card)
get_internal_sink() {
    # 1. Prefer analog-stereo on any PCI card (usually internal speakers)
    local sink
    sink=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^alsa_output\.pci-.*analog-stereo/ {print $2; exit}')
    [[ -n "$sink" ]] && { echo "$sink"; return; }

    # 2. Fallback: any PCI sink on the detected internal card
    local slot
    slot=$(cat "/sys/class/sound/card$INTERNAL_CARD/device/uevent" 2>/dev/null | awk -F= '/^PCI_SLOT_NAME/{print $2}')
    if [[ -n "$slot" ]]; then
        slot=${slot//:*/}  # e.g., 0000:05:00.6 -> 0000:05:00.6
        sink=$(pactl list short sinks 2>/dev/null | awk -v s="$slot" '$2 ~ "alsa_output\\.pci-" s {print $2; exit}')
        [[ -n "$sink" ]] && { echo "$sink"; return; }
    fi

    # 3. Last resort: first PCI sink
    pactl list short sinks 2>/dev/null | awk '$2 ~ /^alsa_output\.pci-/ {print $2; exit}'
}

# Pick best Bluetooth sink (prefer RUNNING, then first)
get_best_bt_sink() {
    local sinks
    mapfile -t sinks < <(get_bt_sinks)
    [[ ${#sinks[@]} -eq 0 ]] && { echo ""; return; }

    # Check for RUNNING state
    for sink in "${sinks[@]}"; do
        if pactl list sinks 2>/dev/null | grep -A5 "Name: $sink" | grep -q "State: RUNNING"; then
            echo "$sink"
            return
        fi
    done
    echo "${sinks[0]}"
}

mute_wired_now() {
    echo "Muting wired outputs..."
    local sinks
    mapfile -t sinks < <(get_wired_sinks)
    for sink in "${sinks[@]}"; do
        pactl set-sink-mute "$sink" 1 2>/dev/null && echo "  muted: $sink"
        pactl set-sink-volume "$sink" 0% 2>/dev/null || true
    done

    # ALSA belt-and-suspenders: mute internal Speaker control
    if amixer -c "$INTERNAL_CARD" get Speaker >/dev/null 2>&1; then
        amixer -c "$INTERNAL_CARD" set Speaker mute >/dev/null 2>&1 && echo "  ALSA: Speaker muted (card $INTERNAL_CARD)"
        amixer -c "$INTERNAL_CARD" set Speaker 0% >/dev/null 2>&1 || true
    fi

    # Route default output to a Bluetooth sink if one exists
    local bt_sink
    bt_sink=$(get_best_bt_sink)
    if [[ -n "${bt_sink:-}" ]]; then
        pactl set-default-sink "$bt_sink" 2>/dev/null && echo "  default sink -> $bt_sink"
        # move existing playback streams to BT
        local inputs
        mapfile -t inputs < <(pactl list short sink-inputs 2>/dev/null | awk '{print $1}')
        for input in "${inputs[@]}"; do
            pactl move-sink-input "$input" "$bt_sink" 2>/dev/null || true
        done
    else
        echo "  note: no Bluetooth sink connected - connect your BT speaker, it will become default"
    fi
}

unmute_wired_now() {
    echo "Restoring wired outputs..."
    local sinks
    mapfile -t sinks < <(get_wired_sinks)

    for sink in "${sinks[@]}"; do
        pactl set-sink-mute "$sink" 0 2>/dev/null && echo "  unmuted: $sink"
        pactl set-sink-volume "$sink" 100% 2>/dev/null || true
    done

    # ALSA unmute
    if amixer -c "$INTERNAL_CARD" get Speaker >/dev/null 2>&1; then
        amixer -c "$INTERNAL_CARD" set Speaker unmute >/dev/null 2>&1 || true
        amixer -c "$INTERNAL_CARD" set Speaker 100% >/dev/null 2>&1 || true
        echo "  ALSA: Speaker unmuted (card $INTERNAL_CARD)"
    fi

    # Set default to internal speakers
    local internal_sink
    internal_sink=$(get_internal_sink)
    if [[ -n "${internal_sink:-}" ]]; then
        pactl set-default-sink "$internal_sink" 2>/dev/null && echo "  default sink -> $internal_sink (internal speakers)"
        # Move all existing playback streams to internal speakers
        local inputs
        mapfile -t inputs < <(pactl list short sink-inputs 2>/dev/null | awk '{print $1}')
        for input in "${inputs[@]}"; do
            pactl move-sink-input "$input" "$internal_sink" 2>/dev/null || true
        done
        echo "  moved ${#inputs[@]} stream(s) to internal speakers"
    else
        echo "  warning: no internal sink found, clearing default"
        pactl set-default-sink "" 2>/dev/null || true
    fi
}

persist_alsa_state() {
    echo "Storing ALSA state (requires sudo)..."
    if command -v alsactl >/dev/null 2>&1; then
        sudo alsactl store 2>/dev/null && echo "  ALSA state stored" || echo "  warning: 'sudo alsactl store' failed (run manually to persist Speaker mute)"
    fi
}

do_enable() {
    mute_wired_now
    persist_alsa_state
    echo "MODE: bluetooth-only ENABLED"
}

do_disable() {
    unmute_wired_now
    persist_alsa_state
    echo "MODE: bluetooth-only DISABLED (internal restored)"
}

do_status() {
    if [[ -f "$CONF_FILE" ]]; then
        echo "MODE: bluetooth-only ENABLED (legacy WirePlumber config present)"
    else
        echo "MODE: bluetooth-only DISABLED (internal allowed)"
    fi
    echo
    echo "--- sinks ---"
    pactl list short sinks 2>/dev/null || wpctl list audio sinks 2>/dev/null || echo "no pactl/wpctl"
    echo
    echo "--- default sink ---"
    pactl get-default-sink 2>/dev/null || echo "unknown"
    echo
    echo "--- ALSA Speaker (card $INTERNAL_CARD) ---"
    amixer -c "$INTERNAL_CARD" get Speaker 2>/dev/null | grep -E '\[on\]|\[off\]|%' || amixer get Speaker 2>/dev/null | grep -E '\[on\]|\[off\]|%' || echo "no Speaker control found"
}

case "${1:-status}" in
    enable|on) do_enable ;;
    disable|off) do_disable ;;
    status|st) do_status ;;
    *) echo "usage: $(basename "$0") [enable|disable|status]"; exit 2 ;;
esac