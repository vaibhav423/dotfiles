#!/usr/bin/env bash
#
# Load env files
for env_file in "$HOME/.secrets" "$HOME/.env" ".env"; do
    if [[ -f "$env_file" ]]; then
        source "$env_file"
    fi
done

# Check if GEMINI_API_KEY is set
if [[ -z "$GEMINI_API_KEY" ]]; then
    echo "Error: GEMINI_API_KEY is not set. Please set it in your environment or in a .env file."
    exit 1
fi

MODEL_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/gemini-models.txt"
LAST_MODEL_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/gemini-last-model.txt"
DEFAULT_MODEL="gemini-3.5-flash-lite"
QUICK_MODEL="gemini-3.5-flash-lite"
THINKING_MODEL="gemini-3.6-flash"

function refresh_models() {
    curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
        | jq -r '.models[].name | sub("^models/"; "")' \
        > "$MODEL_CACHE"
    echo "Model cache refreshed at $MODEL_CACHE"
}

function load_models() {
    if [[ ! -f "$MODEL_CACHE" ]]; then
        refresh_models >&2
    fi
    mapfile -t AVAILABLE_MODELS < "$MODEL_CACHE"
}

function print_help() {
    echo "Usage: ai [-q] [-t] [-l] [--select-model] [--list-models] [--refresh-models] [prompt]"
    echo "  -q                       Use quick model ($QUICK_MODEL)"
    echo "  -t                       Use thinking model ($THINKING_MODEL)"
    echo "  -l                       Use last selected model from --select-model"
    echo "  --list-models            Show all available Gemini models"
    echo "  --select-model           Select a model from the list"
    echo "  --refresh-models         Force refresh the local model cache"
    echo "  --help                   Show this help message"
    echo "  prompt                   The prompt to send to Gemini"
}

function list_models() {
    echo "Available models:"
    for model in "${AVAILABLE_MODELS[@]}"; do
        echo "  $model"
    done
}

function is_valid_model() {
    local check_model="$1"
    for model in "${AVAILABLE_MODELS[@]}"; do
        if [[ "$model" == "$check_model" ]]; then
            return 0
        fi
    done
    return 1
}


function ai() {
    local model_name="$DEFAULT_MODEL"
    local prompt_args=()
    local select_model=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help)
                print_help
                return 0
                ;;
            --list-models)
                load_models
                list_models
                return 0
                ;;
            --refresh-models)
                refresh_models
                return 0
                ;;
            --select-model)
                select_model=1
                shift
                ;;
            -l)
                if [[ -f "$LAST_MODEL_CACHE" ]]; then
                    model_name=$(<"$LAST_MODEL_CACHE")
                else
                    echo "No last model saved yet. Use --select-model first." >&2
                    return 1
                fi
                shift
                ;;
            -q)
                model_name="$QUICK_MODEL"
                shift
                ;;
            -t)
                model_name="$THINKING_MODEL"
                shift
                ;;
            *)
                prompt_args+=("$1")
                shift
                ;;
        esac
    done

    load_models

    if [[ $select_model -eq 1 ]]; then
        if command -v fzf >/dev/null 2>&1; then
            model_name=$(printf "%s\n" "${AVAILABLE_MODELS[@]}" | fzf --prompt="Select Gemini model: ")
            if [[ -z "$model_name" ]]; then
                echo "No model selected."
                return 1
            fi
        else
            echo "fzf not found. Falling back to basic selector."
            select m in "${AVAILABLE_MODELS[@]}"; do
                if [[ -n "$m" ]]; then
                    model_name="$m"
                    break
                else
                    echo "Invalid selection."
                fi
            done
        fi
        echo "$model_name" > "$LAST_MODEL_CACHE"
    fi

    if [[ ${#prompt_args[@]} -eq 0 ]]; then
        if [[ $select_model -eq 1 ]]; then
            echo "Selected model: $model_name"
            return 0
        fi
        
        local stdin_input=""
        if [ -t 0 ]; then
            echo "Enter your prompt (Press Ctrl+D to submit, or Ctrl-E to open nvim):" >&2
            
            _open_nvim_temp() {
                local temp_file=$(mktemp)
                echo -n "$stdin_input$READLINE_LINE" > "$temp_file"
                # Open nvim directly on the TTY to ensure it has full control
                nvim "$temp_file" </dev/tty >/dev/tty 2>&1
                
                # Update stdin_input with the new content
                local file_content
                file_content=$(cat "$temp_file")
                
                # Clear the terminal screen to remove the old prompt clutter
                clear >&2
                
                # Reprint the header
                echo "Enter your prompt (Press Ctrl+D to submit, or Ctrl-E to open nvim):" >&2
                
                # Reprint the edited buffer so it looks like it was naturally typed
                if [[ -n "$file_content" ]]; then
                    # Print each line with "> " prefix
                    awk '{print "> " $0}' "$temp_file" >&2
                fi
                
                # Store the content back
                stdin_input="$file_content"
                
                # Ensure stdin_input has a trailing newline so the next 'read' loop appends correctly
                if [[ -n "$stdin_input" && ! "$stdin_input" =~ $'\n'$ ]]; then
                    stdin_input+=$'\n'
                fi
                
                # Clear the current readline line to avoid duplication on next enter
                READLINE_LINE=""
                READLINE_POINT=0
                
                rm -f "$temp_file"
            }
            
            # Enable emacs editing mode and bind Ctrl-E to the function
            set -o emacs
            bind -x '"\C-e": _open_nvim_temp' 2>/dev/null
            
            # Disable bracketed paste so multi-line pastes are processed line-by-line.
            # This prevents Bash's `read -e` from discarding everything after the first newline.
            bind 'set enable-bracketed-paste off' 2>/dev/null
            
            local line
            # Read line by line with readline support
            while IFS= read -e -p "> " line; do
                stdin_input+="$line"$'\n'
            done
        else
            # Reading from piped input
            stdin_input=$(cat)
        fi
        
        if [[ -n "$stdin_input" ]]; then
            prompt_args=("$stdin_input")
        else
            echo "Error: No prompt provided."
            print_help
            return 1
        fi
    fi
    echo $model_name | glow

    jq -n \
        --arg content "${prompt_args[*]}" \
        '{
          "contents": [
            {
              "parts": [
                {
                  "text": $content
                }
              ]
            }
          ]
        }' | curl --silent --no-buffer \
        --header 'Content-Type: application/json' \
        --data @- \
        --request POST \
        "https://generativelanguage.googleapis.com/v1beta/models/${model_name}:streamGenerateContent?alt=sse&key=$GEMINI_API_KEY" |
        sed -u 's/^data: //' |
        jq -r -j 'select(.candidates) | .candidates[].content.parts[].text' 
    # glow breaks the streaming response / creates unecessary wraps
        # jq -r -j 'select(.candidates) | .candidates[].content.parts[].text' | (command -v glow >/dev/null 2>&1 && glow || cat)
}
ai "$@"
