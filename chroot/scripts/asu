#!/bin/sh

# Enter Android root via APatch su in Android's real mount namespace.
# sudo nsenter -t 1 -m escapes the chroot into Android's true filesystem root
# so /data/adb, getprop, dumpsys etc all work exactly as from a Termux su shell.

CHROOT_HOST_ROOT=${ASU_CHROOT_ROOT:-/data/local/tmp/archl}
ASU_PWD=$PWD

# Android su sees the real Android rootfs, not chroot-relative paths like
# /home/fire/... . Rewrite PWD to the host-side chroot path so relative
# commands such as ./script.sh still resolve correctly from Android's view.
if [ -e "$CHROOT_HOST_ROOT$ASU_PWD" ]; then
  ASU_PWD="$CHROOT_HOST_ROOT$ASU_PWD"
fi

# Android env preamble prepended to every su -c invocation so that
# getprop, dumpsys, iptables etc are on PATH without the caller needing
# to use full paths.
ANDROID_ENV='ANDROID_DATA=/data ANDROID_ROOT=/system PATH=/system/bin:/system/xbin:/data/adb/ap/bin:$PATH LD_LIBRARY_PATH=/system/lib64:/system/lib:/vendor/lib64:/vendor/lib:/odm/lib64:/odm/lib'

if [ $# -eq 0 ]; then
  exec sudo nsenter -t 1 -m -- \
    /system/bin/su -c "export $ANDROID_ENV; cd \"$ASU_PWD\" 2>/dev/null || true; exec /system/bin/sh"
fi

if [ "$1" = "-c" ] && [ $# -ge 2 ]; then
  exec sudo nsenter -t 1 -m -- \
    /system/bin/su -c "export $ANDROID_ENV; cd \"$ASU_PWD\" 2>/dev/null || true; $2"
fi

exec sudo nsenter -t 1 -m -- /system/bin/su "$@"
